# ─────────────────────────────────────────────────────────────────────────────
# Pamarcy Store – Environment Variables Template
# Copy to `.env` (`cp .env.example .env`) and fill in real values locally.
# SECURITY RULES:
#   1. NEVER commit `.env` or real credentials to version control.
#   2. Keep all secret keys, tokens, and passwords strictly server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ───────── Core ─────────
# Production PostgreSQL MUST enforce TLS (append &sslmode=verify-full or &sslmode=require)
# Runtime application connection — MUST use least-privilege role (pamarcy_app: NOSUPERUSER, no DDL)
DATABASE_URL="postgresql://DB_APP_USER:DB_APP_PASSWORD@localhost:5433/pamarcy?schema=public"
# Privileged migration/owner connection — used ONLY by prisma migrate, db:seed, db:harden-permissions & pg_dump
DIRECT_URL="postgresql://DB_ADMIN_USER:DB_ADMIN_PASSWORD@localhost:5433/pamarcy?schema=public"
# Enforce non-superuser least-privilege role check on DATABASE_URL (always enforced in production)
DATABASE_ENFORCE_LEAST_PRIVILEGE="true"
DATABASE_SSL_REQUIRE="false"
# Set ENFORCE_HTTPS="true" behind a reverse proxy to redirect plaintext HTTP -> HTTPS (308)
ENFORCE_HTTPS="false"
PG_USER="DB_USER"
PG_PASSWORD="DB_ADMIN_PASSWORD"
PG_APP_USER="pamarcy_app"
PG_APP_PASSWORD=""
PG_PORT="5433"
PG_DB="pamarcy"
APP_URL="http://localhost:3000"
TZ="Asia/Phnom_Penh"

# Generate with: openssl rand -hex 32 (minimum 32 random characters required)
AUTH_SECRET=""
# Generate with: openssl rand -hex 32 (protects /api/cron/* via `x-cron-secret` or Bearer header)
CRON_SECRET=""

# ───────── Encryption at Rest (AES-256-GCM; NEVER hardcode keys in source code) ─────────
# 256-bit (32-byte) hex or base64 master key for PII/PHI fields, blind indexes & prescription files.
# Generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=""
DATA_ENCRYPTION_KEY_ID="v1"
# Optional comma-separated retired keys for zero-downtime key rotation: "v0:<old_hex>,v1:<prev_hex>"
DATA_ENCRYPTION_KEYRING=""
# Dedicated 256-bit key for AES-256-GCM encrypted database backups (openssl rand -hex 32)
BACKUP_ENCRYPTION_KEY=""

# ───────── Development Seed Passwords (required only when running `npm run db:seed`) ─────────
SEED_SUPERADMIN_PASSWORD=""
SEED_STAFF_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""

# ───────── Image storage (Cloudinary). If empty, uploads are stored in /public/uploads (dev only) ─────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ───────── KHQR / Bakong (NBC Bakong Open API) ─────────
# Register a merchant account at https://api-bakong.nbc.gov.kh and get a token.
BAKONG_API_BASE="https://api-bakong.nbc.gov.kh"
BAKONG_API_TOKEN=""
# Merchant Bakong account id e.g. "pamarcy@aclb" (non-secret details such as merchant name/city are in Admin → Settings → Payments)
BAKONG_ACCOUNT_ID=""

# ───────── USDT verification ─────────
# TRC20 (Tron) – TronGrid API key (https://www.trongrid.io)
TRONGRID_API_BASE="https://api.trongrid.io"
TRONGRID_API_KEY=""
# EVM networks (ERC20 / BEP20 / Polygon) – JSON-RPC endpoints of a trusted provider (Infura, Alchemy, QuickNode…)
ETHEREUM_RPC_URL=""
BSC_RPC_URL=""
POLYGON_RPC_URL=""

# ───────── PayPal (Server-side REST v2 – never expose client-side) ─────────
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# ───────── Bot Protection & CAPTCHA (optional external providers; self-hosted PoW + SVG CAPTCHA works out-of-the-box) ─────────
# auto (default: Turnstile -> hCaptcha -> builtin) | builtin | turnstile | hcaptcha
BOT_PROTECTION_PROVIDER="auto"
# Cloudflare Turnstile (recommended in production; site key is served dynamically by /api/bot-protection/challenge)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# hCaptcha (alternative external provider)
HCAPTCHA_SITE_KEY=""
HCAPTCHA_SECRET_KEY=""
# Optional: comma-separated hostnames accepted from external CAPTCHA responses in production
BOT_PROTECTION_ALLOWED_HOSTNAMES=""
# Optional: allow automatic fallback to self-hosted SVG CAPTCHA if external widget script is blocked (true | false)
BOT_PROTECTION_ALLOW_FALLBACK="true"

# ───────── Email notifications (optional) ─────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Pamarcy Store <no-reply@pamarcy.com.kh>"
