# ─────────────────────────────────────────────────────────────────────────────
# Pamarcy Store – Environment Variables Template
# Copy to `.env` (`cp .env.example .env`) and fill in real values locally.
# SECURITY RULES:
#   1. NEVER commit `.env` or real credentials to version control.
#   2. Keep all secret keys, tokens, and passwords strictly server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ───────── Core ─────────
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5433/pamarcy?schema=public"
PG_USER="DB_USER"
PG_PASSWORD="DB_PASSWORD"
PG_PORT="5433"
PG_DB="pamarcy"
APP_URL="http://localhost:3000"
TZ="Asia/Phnom_Penh"

# Generate with: openssl rand -hex 32 (minimum 32 random characters required)
AUTH_SECRET=""
# Generate with: openssl rand -hex 32 (protects /api/cron/* via `x-cron-secret` or Bearer header)
CRON_SECRET=""

# ───────── Development Seed Passwords (required only when running `npm run db:seed`) ─────────
SEED_SUPERADMIN_PASSWORD=""
SEED_STAFF_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""

# ───────── Image storage (Cloudinary). If empty, uploads are stored in /public/uploads (dev only) ─────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ───────── KHQR / Bakong (NBC Bakong Open API) ─────────
# Register a merchant account at https://api-bakong.nbc.gov.kh and get a token.
BAKONG_API_BASE="https://api-bakong.nbc.gov.kh"
BAKONG_API_TOKEN=""
# Merchant Bakong account id e.g. "pamarcy@aclb" (non-secret details such as merchant name/city are in Admin → Settings → Payments)
BAKONG_ACCOUNT_ID=""

# ───────── USDT verification ─────────
# TRC20 (Tron) – TronGrid API key (https://www.trongrid.io)
TRONGRID_API_BASE="https://api.trongrid.io"
TRONGRID_API_KEY=""
# EVM networks (ERC20 / BEP20 / Polygon) – JSON-RPC endpoints of a trusted provider (Infura, Alchemy, QuickNode…)
ETHEREUM_RPC_URL=""
BSC_RPC_URL=""
POLYGON_RPC_URL=""

# ───────── PayPal (Server-side REST v2 – never expose client-side) ─────────
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# ───────── Bot Protection & CAPTCHA (optional external providers; self-hosted PoW + SVG CAPTCHA works out-of-the-box) ─────────
# auto (default: Turnstile -> hCaptcha -> builtin) | builtin | turnstile | hcaptcha
BOT_PROTECTION_PROVIDER="auto"
# Cloudflare Turnstile (recommended in production; site key is served dynamically by /api/bot-protection/challenge)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# hCaptcha (alternative external provider)
HCAPTCHA_SITE_KEY=""
HCAPTCHA_SECRET_KEY=""
# Optional: comma-separated hostnames accepted from external CAPTCHA responses in production
BOT_PROTECTION_ALLOWED_HOSTNAMES=""
# Optional: allow automatic fallback to self-hosted SVG CAPTCHA if external widget script is blocked (true | false)
BOT_PROTECTION_ALLOW_FALLBACK="true"

# ───────── Email notifications (optional) ─────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Pamarcy Store <no-reply@pamarcy.com.kh>"
