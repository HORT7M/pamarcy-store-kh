# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc & private keys/certificates
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.crt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables & secrets (NEVER commit .env; only .env.example is tracked)
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database, uploads & backups
/.pgdata
.pgdata/
/public/uploads
/storage
/backups
backups/

# temporary local scripts
*.tmp.mjs
*.tmp.ts
*.tmp.js
